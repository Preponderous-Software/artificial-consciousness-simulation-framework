# Optional for OpenAI provider
OPENAI_API_KEY=

# Optional for Anthropic provider
ANTHROPIC_API_KEY=

# Optional for Ollama provider (local open-source models)
OLLAMA_BASE_URL=http://localhost:11434
# Also supported by the ollama python client:
OLLAMA_HOST=http://localhost:11434

# Optional override for persistent data root
CONSCIOUSNESS_HOME=~/.consciousness

# Optional Discord webhook for streaming consciousness events to a channel.
# Create one in Server Settings → Integrations → Webhooks → New Webhook;
# then set `discord.enabled: true` and `discord.webhook_url: "${CONSCIOUSNESS_DISCORD_WEBHOOK}"`
# in your config (the env var is substituted at load time so the URL never
# lives in the YAML). The name CONSCIOUSNESS_DISCORD_WEBHOOK is just the
# default in config/default_consciousness.yaml — use any env var name you
# reference there.
CONSCIOUSNESS_DISCORD_WEBHOOK=
