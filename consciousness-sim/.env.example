# Optional for OpenAI provider
OPENAI_API_KEY=

# Optional for Anthropic provider
ANTHROPIC_API_KEY=

# Optional for Ollama provider (local open-source models)
OLLAMA_BASE_URL=http://localhost:11434
# Also supported by the ollama python client:
OLLAMA_HOST=http://localhost:11434

# Optional override for persistent data root
CONSCIOUSNESS_HOME=~/.consciousness
